{
  "name": "eduverify-api",
  "version": "0.0.1",
  "private": true,
  "description": "Standalone verification API for South African institutions and qualifications, ported from eduverify/web/lib. EduVerify is its first client.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/router.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.cjs",
    "docs": "node scripts/serve-docs.mjs",
    "docs:generate": "tsx scripts/generate-openapi.ts",
    "dynamodb:local": "docker run --rm -p ${PORT:-8000}:${PORT:-8000} amazon/dynamodb-local -jar DynamoDBLocal.jar -sharedDb -port ${PORT:-8000}",
    "seed:local": "tsx scripts/seed-local-dynamodb.ts",
    "dev": "tsx scripts/dev-server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1101.0",
    "@aws-sdk/lib-dynamodb": "^3.1101.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.3.0",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}